# WhatsApp File Echo Bot Configuration

# Path to directory for persisting session credentials
AUTH_DIR=./auth

# Path to directory for temporary file processing
TEMP_DIR=./temp

# Log level (silent, trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Optional: Phone number for pairing code auth (leave empty for QR terminal)
# Format with country code without + or spaces (e.g., 6281234567890)
PAIRING_NUMBER=
